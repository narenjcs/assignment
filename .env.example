# ---- AWS (deploy-time) ----
AWS_PROFILE=default
AWS_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=            # your 12-digit AWS account id
CDK_DEFAULT_REGION=us-east-1
# Bedrock model for the AWS agents. Chosen 2026-09-23 after tool-loop tests: gpt-oss-120b (no Anthropic form needed, $0.15/$0.60 per 1M). Fallback: us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# ---- Databricks (deploy-time) ----
DATABRICKS_CONFIG_PROFILE=docintel
# Workspace (Databricks on AWS): https://dbc-34766815-3348.cloud.databricks.com
DATABRICKS_CATALOG=docintel
DATABRICKS_SCHEMA=docs
DATABRICKS_WAREHOUSE_ID=            # serverless SQL warehouse id (for ai_parse_document + table writes)
DATABRICKS_LLM_ENDPOINT=databricks-gpt-oss-120b   # pay-per-token FMAPI; fallback databricks-meta-llama-3-3-70b-instruct

# ---- Local dev only (never commit real values) ----
# AWS MCP (Gateway) client credentials – produced by `make deploy-aws`, consumed by `make link`
AWS_MCP_TOKEN_URL=
AWS_MCP_CLIENT_ID=
AWS_MCP_CLIENT_SECRET=
AWS_MCP_SCOPE=
AWS_GATEWAY_URL=
# Databricks service principal – produced by `make deploy-databricks`, consumed by `make link`
DATABRICKS_HOST=
DATABRICKS_SP_CLIENT_ID=
DATABRICKS_SP_CLIENT_SECRET=
DATABRICKS_MCP_URL=
